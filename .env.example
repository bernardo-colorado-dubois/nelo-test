########################################################################
# nelo-test — variables de entorno (copiar a .env, que está gitignored)
########################################################################

# ---- AWS / SQS (usadas por read_queue.py, local y dentro del stack) ----
# Credenciales STS temporales — expiran, hay que refrescarlas. Validar con:
#   aws sts get-caller-identity
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
SQS_QUEUE_URL=
SQS_DLQ_URL=

# ---- Google Drive (cuarta tarea del DAG, dags/upload_to_drive.py) --------
# Solo corre dentro del stack (make stack-up) -- make pipeline local no la usa.
# Requiere (ver CLAUDE.md, punto 11 de "Decisiones no obvias" para el porqué):
#   1) una key de cuenta de servicio con la Drive API habilitada, guardada
#      (nunca commiteada) en credentials/google-drive-service-account.json
#   2) compartir la carpeta de Drive destino como Editor con el client_email de esa key
#   3) crear a mano, adentro de esa carpeta, una Google Sheet en blanco con el
#      mismo nombre que dags/etl_pipeline.py pasa como drive_filename (hoy
#      "nelo_dashboard") -- la cuenta de servicio nunca puede crear el archivo,
#      solo actualizar el contenido de una Sheet que ya exista.
# GOOGLE_DRIVE_FOLDER_ID es el segmento después de /folders/ en la URL de esa carpeta.
GOOGLE_DRIVE_FOLDER_ID=

########################################################################
# Stack Airflow + Spark (docker-compose.yaml) — sin componentes de Google.
# Solo hace falta esta sección si vas a levantar el stack (make stack-up);
# el pipeline local (make pipeline) no la necesita.
########################################################################

# ---- Versiones (cambiar acá, en ningún otro lado) ----------------------
AIRFLOW_VERSION=3.3.1
AIRFLOW_IMAGE_NAME=nelo-etl-airflow:${AIRFLOW_VERSION}
SPARK_VERSION=4.1.3
SPARK_SCALA_VERSION=2.13
SPARK_IMAGE_NAME=apache/spark:${SPARK_VERSION}-scala${SPARK_SCALA_VERSION}-java17-python3-ubuntu
PYTHON_VERSION=3.10

# ---- Airflow core --------------------------------------------------------
# OJO: dejar esta línea sin descomentar. `make stack-init` la agrega solo con
# tu UID real (`id -u`) la primera vez, si no existe ya en el archivo. Si la
# pre-completás con un valor fijo (p. ej. 50000), `stack-init` la respeta tal
# cual y `airflow-init` termina siendo dueño de dags/logs/plugins/config con
# un UID que no es el tuyo — tu usuario del host ya no puede editar esos
# archivos (visto en vivo: "Permission denied" al editar dags/etl_pipeline.py).
# AIRFLOW_UID=
AIRFLOW_PROJ_DIR=.
# Defaults de desarrollo local, plug-and-play — cambiar antes de exponer esto
# fuera de localhost. Generar el fernet key propio con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=please_generate_your_own_fernet_key
AIRFLOW_JWT_SECRET=please_change_me_super_secret_jwt
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ---- Celery worker (1 worker x 1 CPU x 4GB RAM) --------------------------
AIRFLOW_WORKER_CPU_LIMIT=1
AIRFLOW_WORKER_MEM_LIMIT=4g
AIRFLOW_WORKER_CONCURRENCY=4

# ---- Cluster Spark standalone --------------------------------------------
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8081
SPARK_WORKER_CORES=1
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_WEBUI_PORT=8082
# Spark Application UI (driver corre acá, deploy_mode=client)
SPARK_DRIVER_UI_PORT=4040

# ---- Postgres / Redis -----------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

########################################################################
# Límites de recursos — calibrados para un host de 8 cores / 32GB.
# Bajarlos más en hosts más chicos.
########################################################################
AIRFLOW_APISERVER_CPU_LIMIT=0.5
AIRFLOW_APISERVER_MEM_LIMIT=1g
AIRFLOW_SCHEDULER_CPU_LIMIT=0.5
AIRFLOW_SCHEDULER_MEM_LIMIT=1g
AIRFLOW_DAGPROCESSOR_CPU_LIMIT=0.3
AIRFLOW_DAGPROCESSOR_MEM_LIMIT=512m
AIRFLOW_TRIGGERER_CPU_LIMIT=0.2
AIRFLOW_TRIGGERER_MEM_LIMIT=512m
SPARK_MASTER_CPU_LIMIT=1
SPARK_MASTER_MEM_LIMIT=1g
POSTGRES_CPU_LIMIT=0.5
POSTGRES_MEM_LIMIT=1g
REDIS_CPU_LIMIT=0.2
REDIS_MEM_LIMIT=256m
