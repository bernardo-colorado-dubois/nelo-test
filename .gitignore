.env
venv/
__pycache__/
*.pyc
output/
data/
messages.json

# Stack Airflow + Spark: logs/plugins/config son montados y escritos por
# los contenedores; se versiona la carpeta (.gitkeep) pero no su contenido.
logs/*
!logs/.gitkeep
plugins/*
!plugins/.gitkeep
config/*
!config/.gitkeep

# Cuarta tarea del DAG (upload_to_drive): key de la cuenta de servicio de
# Google, nunca se commitea (mismo criterio que .env).
credentials/*
!credentials/.gitkeep
